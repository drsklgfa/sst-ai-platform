# Aplicação e implantação
DEPLOY_ENVIRONMENT=development
DB_SCHEMA_MODE=push
RELEASE_VERSION=development
SERVICE_ROLE=web
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sst_saas?schema=public
APP_URL=http://localhost:3000
AUTH_SECRET=change-this-to-at-least-32-random-characters
SESSION_TTL_DAYS=14
NEXT_PUBLIC_APP_NAME=Plataforma SST

# Arquivos: use local em desenvolvimento e s3 na Railway
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.data/storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Exatamente 64 caracteres hexadecimais
FILE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Worker e relatórios
WORKER_POLL_MS=2500
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# Compatibilidade antiga: prefira DB_SCHEMA_MODE.
# RUN_DB_SCHEMA_SYNC=true

# Ativação gradual da Versão 10
FEATURE_V10_WORKS=false
FEATURE_AI_SETTINGS=false
FEATURE_LEGACY_IMPORTS=false
FEATURE_AI_COPILOT=false

# Integrações opcionais
AI_PROVIDER=disabled
# As chaves podem ser cadastradas pelo painel. Estas variáveis são apenas fallback de bootstrap.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=

# Seed inicial: defina antes de executar npm run db:seed
SEED_TENANT_NAME=Minha Consultoria SST
SEED_TENANT_SLUG=minha-consultoria-sst
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=troque-por-uma-senha-forte
SEED_DEMO_DATA=false

# Checkpoint 10.3 — experiência principal, campo e multimodal
FEATURE_V10_HOME=false
FEATURE_FIELD_OPERATIONS=false
FEATURE_MULTIMODAL_INPUT=false

# Checkpoint 10.4 — GRO/PGR e psicossocial
FEATURE_PGR_GRO=false
FEATURE_PSYCHOSOCIAL_GRO=false
FEATURE_PCMSO=false
FEATURE_MEDICAL_AREA=false
FEATURE_ESOCIAL_S2220=false

# Checkpoint 10.6 — LTCAT, PPP, insalubridade, periculosidade e S-2240
FEATURE_EXPOSURE_CORE=false
FEATURE_LTCAT_PPP=false
FEATURE_INSALUBRIDADE=false
FEATURE_PERICULOSIDADE=false
FEATURE_ESOCIAL_S2240=false

FEATURE_ERGONOMICS=false

FEATURE_OCCUPATIONAL_HYGIENE=false
FEATURE_INSTRUMENT_MANAGEMENT=false
FEATURE_CORPORATE_UNIVERSITY=false
FEATURE_TRAINING_ASSESSMENTS=false
FEATURE_COMPETENCY_MATRIX=false
FEATURE_TRAINING_CERTIFICATES=false

# Checkpoint 10.10 — Operação SST 360
FEATURE_OPERATIONAL_SST=false
FEATURE_EPI_EPC=false
FEATURE_INCIDENTS_CAT=false
FEATURE_WORK_PERMITS=false
FEATURE_MACHINES_NR12=false
FEATURE_CHEMICALS=false
FEATURE_EMERGENCY_CIPA=false
FEATURE_CONTRACTORS=false
FEATURE_CLIENT_PORTAL_PLUS=false
FEATURE_ESOCIAL_TRANSMISSION=false
FEATURE_BILLING=false

# Cobrança — habilite primeiro em sandbox
PAYMENT_PROVIDER=disabled
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_HTTP_TIMEOUT_MS=15000
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Compatibilidade para provedor HMAC personalizado; não substitui os segredos específicos acima.
PAYMENT_WEBHOOK_SECRET=
BILLING_CURRENCY=BRL

# Transporte eSocial — exige lote XML previamente assinado e certificado A1/PFX
ESOCIAL_TRANSPORT_MODE=disabled
ESOCIAL_HTTP_TIMEOUT_MS=30000
ESOCIAL_PFX_BASE64=
ESOCIAL_PFX_PASSPHRASE=
ESOCIAL_RESTRICTED_ENDPOINT=
ESOCIAL_PRODUCTION_ENDPOINT=
