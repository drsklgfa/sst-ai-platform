model Tenant {
  id                String                @id @default(uuid())
  name              String
  slug              String                @unique
  logoFileId        String?
  settings          Json                  @default("{}")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  memberships       Membership[]
  companies         Company[]
  questionnaires    Questionnaire[]
  methodologies     Methodology[]
  documentTypes     DocumentType[]
  documentTemplates DocumentTemplate[]
  conversations     Conversation[]
  comments          EntityComment[]
  files             FileObject[]
  jobs              Job[]
  auditLogs         AuditLog[]
  integrations      IntegrationConfig[]
  backups           BackupExport[]
  securityPolicy    TenantSecurityPolicy?
  securityIncidents SecurityIncident[]
  recoveryTests     RecoveryTest[]
  workflowTemplates WorkflowTemplate[]
  workProjects      WorkProject[]
  aiThreads         AIThread[]
  aiToolExecutions  AIToolExecution[]
  aiUsageRecords    AIUsageRecord[]
  legacyImports     LegacyImportBatch[]
  fieldVisits       FieldVisit[]
  pgrPrograms       PgrProgram[]
  pcmsoPrograms     PcmsoProgram[]
  exposurePrograms  OccupationalExposureProgram[]
  ergonomicsPrograms ErgonomicsProgram[]
  hygienePrograms OccupationalHygieneProgram[]
  measurementInstruments MeasurementInstrument[]
  technicalProfessionals OccupationalTechnicalProfessional[]
  occupationalWorkers OccupationalWorker[]
  medicalProviders  MedicalProvider[]
  medicalProfessionals MedicalProfessional[]
  medicalExamCatalog PcmsoExamCatalog[]
  medicalAccessLogs MedicalDataAccessLog[]
  trainingPrograms TrainingProgram[]
  trainingCourses TrainingCourse[]
  trainingPaths TrainingPath[]
  trainingRequirementRules TrainingRequirementRule[]
  trainingEnrollments TrainingEnrollment[]
  trainingSessions TrainingSession[]
  trainingCertificates TrainingCertificate[]
  competencyDefinitions CompetencyDefinition[]
  workerCompetencies WorkerCompetency[]
}

model User {
  id                       String                    @id @default(uuid())
  name                     String
  email                    String                    @unique
  passwordHash             String?
  active                   Boolean                   @default(true)
  lastLoginAt              DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  memberships              Membership[]
  companyAccesses          CompanyAccess[]
  sessions                 Session[]
  notifications            Notification[]
  messages                 Message[]
  conversationParticipants ConversationParticipant[]
  comments                 EntityComment[]
  invites                  UserInvite[]
  ownedSecurityIncidents   SecurityIncident[]        @relation("IncidentOwner")
  createdRecoveryTests     RecoveryTest[]            @relation("RecoveryTestCreator")
}

model Membership {
  id          String         @id @default(uuid())
  tenantId    String
  userId      String
  role        MembershipRole
  permissions Json           @default("[]")
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tenantId, userId])
  @@index([tenantId, role])
}

model UserInvite {
  id          String    @id @default(uuid())
  userId      String
  companyId   String?
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Company {
  id             String            @id @default(uuid())
  tenantId       String
  legalName      String
  tradeName      String?
  cnpj           String?
  primaryCnae    String?
  riskGrade      Int?
  employeeCount  Int               @default(0)
  managerName    String?
  logoFileId     String?
  status         CompanyStatus     @default(ACTIVE)
  settings       Json              @default("{}")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts       CompanyContact[]
  establishments Establishment[]
  accesses       CompanyAccess[]
  campaigns      Campaign[]
  inspections    Inspection[]
  risks          Risk[]
  actionPlans    ActionPlan[]
  documents      Document[]
  conversations  Conversation[]
  comments       EntityComment[]
  files          FileObject[]
  backups        BackupExport[]
  invites        UserInvite[]
  services       ServiceContract[]
  workProjects   WorkProject[]
  aiThreads      AIThread[]
  legacyImports  LegacyImportBatch[]
  fieldVisits    FieldVisit[]
  pgrPrograms    PgrProgram[]
  pcmsoPrograms  PcmsoProgram[]
  exposurePrograms OccupationalExposureProgram[]
  ergonomicsPrograms ErgonomicsProgram[]
  hygienePrograms OccupationalHygieneProgram[]
  measurementInstruments MeasurementInstrument[]
  occupationalWorkers OccupationalWorker[]
  trainingPrograms TrainingProgram[]
  trainingCourses TrainingCourse[]
  trainingPaths TrainingPath[]
  trainingRequirementRules TrainingRequirementRule[]
  trainingEnrollments TrainingEnrollment[]
  trainingSessions TrainingSession[]
  trainingCertificates TrainingCertificate[]
  competencyDefinitions CompetencyDefinition[]
  workerCompetencies WorkerCompetency[]
  @@index([tenantId, status])
  @@unique([tenantId, cnpj])
}

model CompanyContact {
  id               String   @id @default(uuid())
  companyId        String
  name             String
  role             String?
  email            String?
  phoneDisplay     String?
  phoneE164        String?
  hasWhatsapp      Boolean  @default(false)
  preferredChannel String?
  isPrimary        Boolean  @default(false)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId, isPrimary])
}

model CompanyAccess {
  id          String          @id @default(uuid())
  companyId   String
  userId      String
  role        CompanyUserRole
  permissions Json            @default("[]")
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([companyId, userId])
}

model Establishment {
  id            String   @id @default(uuid())
  companyId     String
  name          String
  cnpj          String?
  addressLine   String?
  number        String?
  district      String?
  city          String?
  state         String?
  zipCode       String?
  employeeCount Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sectors       Sector[]
  occupationalWorkers OccupationalWorker[]
  exposurePeriods OccupationalExposurePeriod[]
  @@index([companyId])
}

model Sector {
  id              String        @id @default(uuid())
  establishmentId String
  name            String
  description     String?
  employeeCount   Int           @default(0)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  ghes            GHE[]
  fieldCaptures   FieldCapture[]
  exposurePeriods OccupationalExposurePeriod[]
  @@index([establishmentId])
}

model GHE {
  id               String            @id @default(uuid())
  sectorId         String
  code             String?
  name             String
  description      String?
  employeeCount    Int               @default(0)
  shift            String?
  workday          String?
  metadata         Json              @default("{}")
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sector           Sector            @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  functions        JobFunction[]
  workstations     Workstation[]
  targets          CampaignTarget[]
  responseSessions ResponseSession[]
  inspections      Inspection[]
  risks            Risk[]
  fieldCaptures    FieldCapture[]
  pgrAssessments   PgrRiskAssessment[]
  occupationalWorkers OccupationalWorker[]
  pcmsoExamRequirements PcmsoExamRequirement[]
  exposurePeriods OccupationalExposurePeriod[]
  trainingRequirementRules TrainingRequirementRule[]
  competencyRequirements CompetencyRequirement[]
  @@index([sectorId])
}

model JobFunction {
  id            String   @id @default(uuid())
  gheId         String
  name          String
  cbo           String?
  description   String?
  employeeCount Int      @default(0)
  activities    Json     @default("[]")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ghe           GHE      @relation(fields: [gheId], references: [id], onDelete: Cascade)
  fieldCaptures FieldCapture[]
  occupationalWorkers OccupationalWorker[]
  pcmsoExamRequirements PcmsoExamRequirement[]
  exposurePeriods OccupationalExposurePeriod[]
  trainingRequirementRules TrainingRequirementRule[]
  competencyRequirements CompetencyRequirement[]
  @@index([gheId])
}

model Workstation {
  id          String   @id @default(uuid())
  gheId       String
  name        String
  description String?
  metadata    Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ghe         GHE      @relation(fields: [gheId], references: [id], onDelete: Cascade)
  fieldCaptures FieldCapture[]
}

model ServiceContract {
  id                String        @id @default(uuid())
  companyId         String
  code              String
  name              String
  category          String?
  description       String?
  status            ServiceStatus @default(PROPOSAL)
  contractedValue   Decimal?      @db.Decimal(14, 2)
  contractedAt      DateTime?
  startsAt          DateTime?
  dueAt             DateTime?
  deliveredAt       DateTime?
  renewalAt         DateTime?
  renewalNoticeDays Int           @default(30)
  responsibleName   String?
  purchaseOrder     String?
  notes             String?
