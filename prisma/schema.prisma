  status               SubscriptionStatus @default(TRIAL)
  provider             PaymentProvider    @default(MANUAL)
  providerCustomerId   String?
  providerSubscriptionId String?
  startedAt            DateTime            @default(now())
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean             @default(false)
  cancelledAt          DateTime?
  suspendedAt          DateTime?
  metadata             Json                @default("{}")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  @@index([tenantId, status, currentPeriodEnd])
  @@index([provider, providerSubscriptionId])
}

model BillingInvoice {
  id                   String               @id @default(uuid())
  tenantId             String
  subscriptionId       String?
  provider             PaymentProvider      @default(MANUAL)
  providerInvoiceId    String?
  status               BillingInvoiceStatus @default(DRAFT)
  description          String
  amountCents          Int
  currency             String               @default("BRL")
  dueAt                DateTime
  paidAt               DateTime?
  voidedAt             DateTime?
  checkoutUrl          String?
  pixPayload           String?
  metadata             Json                 @default("{}")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  @@index([tenantId, status, dueAt])
  @@index([provider, providerInvoiceId])
}

model BillingUsageRecord {
  id                   String             @id @default(uuid())
  tenantId             String
  subscriptionId       String?
  metric               BillingUsageMetric
  quantity             BigInt
  periodStart          DateTime
  periodEnd            DateTime
  source               String
  sourceId             String?
  metadata             Json               @default("{}")
  createdAt            DateTime           @default(now())
  @@unique([tenantId, metric, periodStart, periodEnd, source, sourceId])
  @@index([subscriptionId, metric, periodStart])
}

model PaymentWebhookEvent {
  id                   String             @id @default(uuid())
  tenantId             String?
  provider             PaymentProvider
  externalId           String
  eventType            String
  status               PaymentEventStatus @default(RECEIVED)
  signatureValid       Boolean            @default(false)
  payload              Json
  processedAt          DateTime?
  error                String?
  createdAt            DateTime           @default(now())
  @@unique([provider, externalId])
  @@index([tenantId, status, createdAt])
}
