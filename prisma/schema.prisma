enum TrainingProgramStatus {
  DRAFT
  ACTIVE
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum TrainingCourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum TrainingModality {
  PRESENTIAL
  LIVE_ONLINE
  E_LEARNING
  BLENDED
}

enum TrainingContentKind {
  TEXT
  VIDEO
  AUDIO
  PDF
  PRESENTATION
  EXTERNAL_LINK
  LIVE_SESSION
  PRACTICAL_ACTIVITY
}

enum TrainingLessonStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  WAIVED
}

enum TrainingAssessmentType {
  DIAGNOSTIC
  THEORETICAL
  PRACTICAL
  RECERTIFICATION
}

enum TrainingQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_TEXT
}

enum TrainingAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  PENDING_MANUAL_REVIEW
  PASSED
  FAILED
  CANCELLED
}

enum TrainingPathStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TrainingEnrollmentStatus {
  ASSIGNED
  NOT_STARTED
  IN_PROGRESS
  AWAITING_PRACTICAL
  AWAITING_REVIEW
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum TrainingRequirementSource {
  MANUAL
  JOB_FUNCTION
  GHE
  RISK
  EXPOSURE
  EQUIPMENT
  LEGAL_RULE
  AI_SUGGESTION
}

enum TrainingSessionStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TrainingPracticalStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
}

enum TrainingCertificateStatus {
  ISSUED
  EXPIRED
  REVOKED
}

enum TrainingAccessAction {
  LOGIN
  LESSON_OPENED
  LESSON_HEARTBEAT
  LESSON_COMPLETED
  ASSESSMENT_STARTED
  ASSESSMENT_SUBMITTED
  LIVE_CHECK_IN
  LIVE_CHECK_OUT
  MATERIAL_DOWNLOADED
}

enum CompetencyStatus {
  PENDING
  VALID
  EXPIRING
  EXPIRED
  SUSPENDED
  REVOKED
}

enum TrainingAuditStatus {
  PASSED
  PASSED_WITH_WARNINGS
  FAILED
}

model TrainingProgram {
  id                         String                @id @default(uuid())
  tenantId                   String
  companyId                  String
  workProjectId              String                @unique
  title                      String
  status                     TrainingProgramStatus @default(DRAFT)
  scope                      String?
  targetAudience             Json                  @default("[]")
  pedagogicalProject         Json                  @default("{}")
  modality                   TrainingModality      @default(BLENDED)
  workloadMinutes            Int                   @default(0)
  practicalWorkloadMinutes   Int                   @default(0)
  validityDays               Int?
  minimumScore               Decimal               @default(70) @db.Decimal(5, 2)
  maxAttempts                Int                   @default(3)
  logsRetentionDays          Int                   @default(1825)
  instructorName             String?
  technicalResponsibleName   String?
  approvedAt                 DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  tenant                     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company                    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workProject                WorkProject           @relation(fields: [workProjectId], references: [id], onDelete: Cascade)
  courses                    TrainingProgramCourse[]
  enrollments                TrainingEnrollment[]
  sessions                   TrainingSession[]
  audits                     TrainingAuditRun[]
  @@index([tenantId, status, updatedAt])
  @@index([companyId, status])
}

model TrainingCourse {
  id                         String                @id @default(uuid())
  tenantId                   String
  companyId                  String?
  code                       String
  title                      String
  description                String?
  version                    Int                   @default(1)
  status                     TrainingCourseStatus  @default(DRAFT)
  modality                   TrainingModality      @default(E_LEARNING)
  workloadMinutes            Int
  practicalWorkloadMinutes   Int                   @default(0)
  validityDays               Int?
  minimumScore               Decimal               @default(70) @db.Decimal(5, 2)
  maxAttempts                Int                   @default(3)
  requiresPractical          Boolean               @default(false)
  objectives                 Json                  @default("[]")
  prerequisites              Json                  @default("[]")
  contentProgram             Json                  @default("[]")
  legalReferences            Json                  @default("[]")
  accessibility              Json                  @default("{}")
  metadata                   Json                  @default("{}")
  publishedAt                DateTime?
  archivedAt                 DateTime?
  createdById                String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  tenant                     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company                    Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  modules                    TrainingModule[]
  assessments                TrainingAssessment[]
  programLinks               TrainingProgramCourse[]
  pathLinks                  TrainingPathCourse[]
  requirementRules           TrainingRequirementRule[]
  enrollments                TrainingEnrollment[]
  sessions                   TrainingSession[]
  competencyRequirements     CompetencyRequirement[]
  @@unique([tenantId, code, version])
  @@index([tenantId, status, title])
  @@index([companyId, status])
}

model TrainingProgramCourse {
  id                         String          @id @default(uuid())
  trainingProgramId          String
  courseId                   String
  order                      Int             @default(0)
  required                   Boolean         @default(true)
  trainingProgram            TrainingProgram @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)
  course                     TrainingCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([trainingProgramId, courseId])
  @@index([trainingProgramId, order])
}

model TrainingModule {
  id                         String           @id @default(uuid())
  courseId                   String
  code                       String
  title                      String
  description                String?
  order                      Int              @default(0)
  mandatory                  Boolean          @default(true)
  estimatedMinutes           Int              @default(0)
  course                     TrainingCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons                    TrainingLesson[]
  @@unique([courseId, code])
  @@index([courseId, order])
}

model TrainingLesson {
  id                         String              @id @default(uuid())
  moduleId                   String
  code                       String
  title                      String
  description                String?
  order                      Int                 @default(0)
  kind                       TrainingContentKind
  estimatedMinutes           Int                 @default(0)
  mandatory                  Boolean             @default(true)
  content                    Json                @default("{}")
  completionCriteria         Json                @default("{}")
  fileId                     String?
  externalUrl                String?
  module                     TrainingModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  file                       FileObject?          @relation(fields: [fileId], references: [id], onDelete: SetNull)
  progress                   TrainingLessonProgress[]
  accessLogs                 TrainingAccessLog[]
  @@unique([moduleId, code])
  @@index([moduleId, order])
}

model TrainingAssessment {
  id                         String                 @id @default(uuid())
  courseId                   String
  title                      String
  type                       TrainingAssessmentType @default(THEORETICAL)
  passingScore               Decimal                @default(70) @db.Decimal(5, 2)
  maxAttempts                Int                    @default(3)
  questionCount              Int?
  randomizeQuestions         Boolean                @default(true)
  randomizeOptions           Boolean                @default(true)
  active                     Boolean                @default(true)
  instructions               String?
  course                     TrainingCourse         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions                  TrainingQuestion[]
  attempts                   TrainingAssessmentAttempt[]
  @@index([courseId, active])
}

model TrainingQuestion {
  id                         String               @id @default(uuid())
  assessmentId               String
  code                       String
  type                       TrainingQuestionType
  prompt                     String
  options                    Json                 @default("[]")
  correctAnswer              Json                 @default("null")
  explanation                String?
  weight                     Decimal              @default(1) @db.Decimal(8, 3)
  order                      Int                  @default(0)
  active                     Boolean              @default(true)
  assessment                 TrainingAssessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  @@unique([assessmentId, code])
  @@index([assessmentId, active, order])
}

model TrainingPath {
  id                         String             @id @default(uuid())
  tenantId                   String
  companyId                  String?
  code                       String
  title                      String
  description                String?
  status                     TrainingPathStatus @default(DRAFT)
  validityDays               Int?
  metadata                   Json               @default("{}")
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  tenant                     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company                    Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  courses                    TrainingPathCourse[]
  requirementRules           TrainingRequirementRule[]
  enrollments                TrainingEnrollment[]
  @@unique([tenantId, code])
  @@index([companyId, status])
}

model TrainingPathCourse {
  id                         String         @id @default(uuid())
  pathId                     String
  courseId                   String
  order                      Int            @default(0)
  required                   Boolean        @default(true)
  path                       TrainingPath   @relation(fields: [pathId], references: [id], onDelete: Cascade)
  course                     TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([pathId, courseId])
  @@index([pathId, order])
}

model TrainingRequirementRule {
  id                         String                    @id @default(uuid())
  tenantId                   String
  companyId                  String?
  courseId                   String?
  pathId                     String?
  jobFunctionId              String?
  gheId                      String?
  exposureAgentId            String?
  riskCategory               String?
  source                     TrainingRequirementSource
  mandatory                  Boolean                   @default(true)
  recurrenceDays             Int?
  legalBasis                 Json                      @default("[]")
  conditions                 Json                      @default("{}")
  active                     Boolean                   @default(true)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  tenant                     Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company                    Company?                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  course                     TrainingCourse?           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  path                       TrainingPath?             @relation(fields: [pathId], references: [id], onDelete: Cascade)
  jobFunction                JobFunction?              @relation(fields: [jobFunctionId], references: [id], onDelete: Cascade)
  ghe                        GHE?                      @relation(fields: [gheId], references: [id], onDelete: Cascade)
  enrollments                TrainingEnrollment[]
  @@index([tenantId, active, source])
  @@index([companyId, active])
  @@index([jobFunctionId, gheId])
  @@index([courseId, pathId])
}

model TrainingEnrollment {
  id                         String                   @id @default(uuid())
  tenantId                   String
  companyId                  String
  trainingProgramId          String
  workerId                   String
  courseId                   String
  pathId                     String?
  requirementRuleId          String?
  status                     TrainingEnrollmentStatus @default(ASSIGNED)
  source                     TrainingRequirementSource @default(MANUAL)
  assignedAt                 DateTime                 @default(now())
  dueAt                      DateTime?
  startedAt                  DateTime?
  completedAt                DateTime?
  expiresAt                  DateTime?
  progress                   Int                      @default(0)
  finalScore                 Decimal?                 @db.Decimal(5, 2)
  assignedById               String?
  accessTokenHash            String?                  @unique
  accessTokenIssuedAt        DateTime?
  accessTokenExpiresAt       DateTime?
  lastAccessAt               DateTime?
  metadata                   Json                     @default("{}")
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
